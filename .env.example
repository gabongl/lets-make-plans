# ==============================================================================
# 🐿️ Let's make plans! - Lark(Feishu) Base Bitable 연동 환경변수 설정 가이드
# ==============================================================================
# ※ 본 설정값이 없어도 앱은 로컬/메모리 저장소 모드로 100% 정상 작동합니다.
# ※ Lark Open Platform (https://open.larksuite.com 혹은 https://open.feishu.cn)에서
#   앱을 생성하고 아래 값을 채우면 즉시 정식 Lark Bitable DB로 자동 전환됩니다.

# 1. Lark API 도메인 (글로벌: open.larksuite.com / 중국 내수: open.feishu.cn)
LARK_API_DOMAIN=https://open.larksuite.com

# 2. Lark 개발자 콘솔에서 발급받은 App ID 및 App Secret
LARK_APP_ID=cli_xxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. 사용할 Base(Bitable)의 App Token (URL의 /base/ 뒷부분 문자열)
# 예: https://your-org.larksuite.com/base/bascnAbCdEf123456 -> bascnAbCdEf123456
LARK_BASE_TOKEN=bascnxxxxxxxxxxxxxx

# 4. 모임 정보 테이블 ID 및 응답 테이블 ID (테이블 탭 우클릭 또는 URL 매개변수의 table=tblXXXXX)
LARK_TABLE_MEETINGS=tblXXXXXXXXXXXX
LARK_TABLE_RESPONSES=tblYYYYYYYYYYYY

